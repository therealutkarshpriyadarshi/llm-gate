{
  "title": "LLM Gateway - Cache Effectiveness",
  "uid": "llm-gateway-cache",
  "tags": ["llm-gateway", "cache"],
  "timezone": "",
  "schemaVersion": 38,
  "version": 0,
  "refresh": "10s",
  "panels": [
    {
      "title": "Cache Hit Rate",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [
        {"expr": "llmgate_cache_hit_rate", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 0.4, "color": "yellow"},
              {"value": 0.6, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "title": "Cache Hits vs Misses",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0},
      "targets": [
        {"expr": "rate(llmgate_cache_requests_total{result=\"hit\"}[5m])", "legendFormat": "Hits"},
        {"expr": "rate(llmgate_cache_requests_total{result=\"miss\"}[5m])", "legendFormat": "Misses"}
      ]
    },
    {
      "title": "Similarity Score Distribution",
      "type": "heatmap",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "rate(llmgate_cache_similarity_score_bucket[5m])", "format": "heatmap"}
      ]
    },
    {
      "title": "Embedding Generation Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, rate(llmgate_embedding_generation_duration_seconds_bucket[5m]))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, rate(llmgate_embedding_generation_duration_seconds_bucket[5m]))", "legendFormat": "p99"}
      ]
    },
    {
      "title": "Cache Size",
      "type": "graph",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "targets": [
        {"expr": "llmgate_cache_size_bytes", "legendFormat": "Size (bytes)"}
      ]
    },
    {
      "title": "Cache Entries",
      "type": "graph",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "targets": [
        {"expr": "llmgate_cache_entries", "legendFormat": "Entries"}
      ]
    },
    {
      "title": "Cost Savings from Cache",
      "type": "stat",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
      "targets": [
        {"expr": "sum(increase(llmgate_cache_requests_total{result=\"hit\"}[24h])) * 0.0001", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    }
  ],
  "time": {"from": "now-1h", "to": "now"}
}
