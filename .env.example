# Server Configuration
LLMGATE_SERVER_PORT=8080
LLMGATE_SERVER_HOST=0.0.0.0

# Logging
LLMGATE_LOG_LEVEL=info
LLMGATE_LOG_FORMAT=json

# Redis Cache
LLMGATE_CACHE_ENABLED=false
LLMGATE_CACHE_HOST=localhost
LLMGATE_CACHE_PORT=6379
LLMGATE_CACHE_PASSWORD=
LLMGATE_CACHE_DB=0

# PostgreSQL Database
LLMGATE_DATABASE_HOST=localhost
LLMGATE_DATABASE_PORT=5432
LLMGATE_DATABASE_USER=llmgate
LLMGATE_DATABASE_PASSWORD=llmgate
LLMGATE_DATABASE_DATABASE=llmgate
LLMGATE_DATABASE_SSL_MODE=disable

# Metrics
LLMGATE_METRICS_ENABLED=true
LLMGATE_METRICS_PORT=9090
LLMGATE_METRICS_PATH=/metrics

# LLM Provider API Keys (to be used in later phases)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://...
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# GOOGLE_CLOUD_PROJECT=...
